{
  "name": "port-ops-simulator",
  "productName": "Port Ops Simulator",
  "version": "1.0.0",
  "description": "A polished 2D port operations simulator: learn, drive and master container terminal machinery. Fully offline, no accounts, no cloud.",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.cjs",
  "private": true,
  "scripts": {
    "start": "node tools/serve.js",
    "dev": "node tools/serve.js",
    "serve": "node tools/serve.js",
    "bundle": "node tools/bundle.js",
    "smoke": "node tools/smoke.mjs",
    "art": "node tools/render-preview.mjs",
    "electron": "electron desktop/main.cjs",
    "electron:build": "electron-builder --win --x64",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open:android": "npx cap open android"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "game",
    "simulation",
    "port",
    "terminal",
    "canvas2d",
    "offline",
    "educational"
  ],
  "optionalDependencies": {},
  "devDependencies": {},
  "build": {
    "appId": "com.portops.simulator",
    "productName": "Port Ops Simulator",
    "files": [
      "desktop/**",
      "dist/**",
      "assets/**",
      "index.html",
      "src/**",
      "styles/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "directories": {
      "output": "release"
    }
  },
  "capacitor": {
    "appId": "com.portops.simulator",
    "appName": "Port Ops Simulator",
    "webDir": "dist"
  }
}
