{
  "name": "port-ops-simulator",
  "productName": "Port Ops Simulator",
  "version": "1.0.0",
  "description": "A polished 2D port operations simulator: learn, drive and master container terminal machinery. Fully offline, no accounts, no cloud.",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.cjs",
  "private": true,
  "scripts": {
    "start": "node tools/serve.js",
    "dev": "node tools/serve.js",
    "serve": "node tools/serve.js",
    "bundle": "node tools/bundle.js",
    "smoke": "node tools/smoke.mjs",
    "art": "node tools/render-preview.mjs",
    "electron": "npm run bundle && electron desktop/main.cjs",
    "electron:build": "npm run bundle && electron-builder --win --x64",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run bundle && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "e2e": "node tools/e2e.mjs",
    "electron:build:portable": "npm run bundle && electron-builder --win portable --x64",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "game",
    "simulation",
    "port",
    "terminal",
    "canvas2d",
    "offline",
    "educational"
  ],
  "optionalDependencies": {},
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.portops.simulator",
    "productName": "Port Ops Simulator",
    "files": [
      "desktop/**",
      "dist/www/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "author": "Port Ops Simulator"
}
